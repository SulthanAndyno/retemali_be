# ───────────────────────────────────────────────────────────────
# Rete Mali API — environment template
# Copy to .env (`cp .env.example .env`) and fill in the values.
#
# Everything in this file is RUNTIME configuration: it is read when the
# process starts, so one build artefact runs in any environment.
# Nothing here is compiled into the code.
# ───────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# Port the API listens on. The frontend defaults to http://localhost:5000.
PORT=5000

# Comma-separated list of browser origins allowed by CORS.
# In development http://localhost:3000 and http://127.0.0.1:3000 are
# always allowed on top of this list.
#   CLIENT_URL="https://retemali.id,https://www.retemali.id"
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────
# The only variable a standalone PostgreSQL / Docker / VPS needs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retemali_db?schema=public"

# TLS for the PostgreSQL connection. Leave EMPTY to auto-detect:
#   - sslmode=require (or verify-ca / verify-full) in DATABASE_URL -> TLS on
#   - known managed hosts (supabase.com, neon.tech, rds.amazonaws.com, ...) -> TLS on
#   - anything else (localhost, docker service name) -> TLS off
# Set it explicitly when in doubt: true for hosted/managed PostgreSQL,
# false for a local or docker-compose PostgreSQL.
# DATABASE_SSL=false

# OPTIONAL — only for managed providers that need a different connection
# for migrations than for the app. On Supabase, DATABASE_URL is the
# transaction pooler (port 6543) and DDL must run through the session
# pooler (port 5432):
#   DIRECT_URL="postgresql://postgres:PASSWORD@db.<project>.supabase.co:5432/postgres"
# On a standalone PostgreSQL omit it: the Prisma CLI falls back to DATABASE_URL.
# DIRECT_URL=

# ── Auth ───────────────────────────────────────────────────────
# Signing key for issued JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-run-openssl-rand-hex-32"
