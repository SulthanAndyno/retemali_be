# ───────────────────────────────────────────────────────────────
# Rete Mali web app — environment template
# Copy to .env.local (`cp .env.example .env.local`) and fill in.
# ───────────────────────────────────────────────────────────────

# BUILD-TIME variable — inlined into the browser bundle by `next build`.
# Changing it requires a REBUILD (in Docker: `--build-arg NEXT_PUBLIC_API_URL=...`).
# It is also what whitelists the API host for next/image, so uploaded book
# covers, QRIS codes, avatars and payment proofs load in production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# RUNTIME variable — read by the Next.js route handlers (server side only,
# never shipped to the browser). Point it at the API over the internal
# network in Docker (e.g. http://api:5000/api) while NEXT_PUBLIC_API_URL
# keeps the public URL the browser uses.
API_URL=http://localhost:5000/api

# Optional. WhatsApp CTA number in international format without "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
